{
  "name": "ainotation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run @ainotation/playground#dev",
    "dev:react": "vp run @ainotation/react#dev",
    "dev:vue": "vp run @ainotation/vue#dev",
    "dev:apps": "vp run --parallel --filter @ainotation/playground --filter @ainotation/react --filter @ainotation/vue dev",
    "storybook": "vp run @ainotation/storybook#dev",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "typecheck": "vp run -r typecheck",
    "check": "vp check",
    "ready": "vp check && vp run typecheck && vp run test && vp run build",
    "changeset": "changeset",
    "version-packages": "changeset version && vp install --lockfile-only",
    "build:packages": "vp run --filter @ainotation/schema --filter @ainotation/sdk --filter @ainotation/mcp --filter @ainotation/vite build",
    "release": "node scripts/publish-packages.mjs",
    "release:check": "node scripts/check-packages.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^24.20.0"
  },
  "packageManager": "pnpm@12.3.4"
}
