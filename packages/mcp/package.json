{
  "name": "@ainotation/mcp",
  "version": "1.0.0-beta.1",
  "description": "Local, workspace-scoped MCP service for Ainotation feedback and image attachments",
  "homepage": "https://github.com/nightire/ainotation#readme",
  "bugs": {
    "url": "https://github.com/nightire/ainotation/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightire/ainotation.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "ainotation-mcp": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./project": {
      "development": "./src/project.ts",
      "types": "./dist/project.d.mts",
      "import": "./dist/project.mjs"
    },
    "./service": {
      "development": "./src/shared-service.ts",
      "types": "./dist/shared-service.d.mts",
      "import": "./dist/shared-service.mjs"
    },
    "./discovery": {
      "development": "./src/service-discovery.ts",
      "types": "./dist/service-discovery.d.mts",
      "import": "./dist/service-discovery.mjs"
    },
    "./bridge": {
      "development": "./src/project-mcp.ts",
      "types": "./dist/project-mcp.d.mts",
      "import": "./dist/project-mcp.mjs"
    },
    "./browser": {
      "development": "./src/browser-connection.ts",
      "types": "./dist/browser-connection.d.mts",
      "import": "./dist/browser-connection.mjs"
    },
    "./registration": {
      "development": "./src/project-registration.ts",
      "types": "./dist/project-registration.d.mts",
      "import": "./dist/project-registration.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./project": {
        "types": "./dist/project.d.mts",
        "import": "./dist/project.mjs"
      },
      "./service": {
        "types": "./dist/shared-service.d.mts",
        "import": "./dist/shared-service.mjs"
      },
      "./discovery": {
        "types": "./dist/service-discovery.d.mts",
        "import": "./dist/service-discovery.mjs"
      },
      "./bridge": {
        "types": "./dist/project-mcp.d.mts",
        "import": "./dist/project-mcp.mjs"
      },
      "./browser": {
        "types": "./dist/browser-connection.d.mts",
        "import": "./dist/browser-connection.mjs"
      },
      "./registration": {
        "types": "./dist/project-registration.d.mts",
        "import": "./dist/project-registration.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/prepare-package.mjs",
    "build": "vp pack",
    "start": "node dist/cli.mjs",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ainotation/schema": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.20.0"
  }
}
