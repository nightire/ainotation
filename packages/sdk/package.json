{
  "name": "@ainotation/sdk",
  "version": "1.0.0-beta.1",
  "description": "Framework-independent DOM feedback, live drawing and screenshot annotations",
  "homepage": "https://github.com/nightire/ainotation#readme",
  "bugs": {
    "url": "https://github.com/nightire/ainotation/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightire/ainotation.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ui": {
      "development": "./src/ui/index.ts",
      "types": "./dist/ui.d.mts",
      "import": "./dist/ui.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./ui": {
        "types": "./dist/ui.d.mts",
        "import": "./dist/ui.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/prepare-package.mjs",
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@ainotation/schema": "workspace:*",
    "idb": "catalog:",
    "lit": "catalog:",
    "lucide": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
