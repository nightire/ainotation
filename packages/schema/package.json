{
  "name": "@ainotation/schema",
  "version": "1.0.0-beta.1",
  "description": "Shared feedback contracts and Markdown/JSON handoff for Ainotation",
  "homepage": "https://github.com/nightire/ainotation#readme",
  "bugs": {
    "url": "https://github.com/nightire/ainotation/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightire/ainotation.git",
    "directory": "packages/schema"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
