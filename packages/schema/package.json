      }
    },
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/prepare-package.mjs",
    "build": "vp pack",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
